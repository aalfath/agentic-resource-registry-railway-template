# Rendered at start by the nginx image (envsubst of PORT, API_HOST, API_PORT,
# NGINX_LOCAL_RESOLVERS only) to /etc/nginx/conf.d/default.conf.
# Based on upstream's docker/nginx-spa.conf and docker/nginx.conf (v1.17.1).

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

# Railway's edge sets X-Real-IP (the visitor) and X-Forwarded-Proto (https).
map $http_x_real_ip $railway_client_ip {
    ""      $remote_addr;
    default $http_x_real_ip;
}
map $http_x_forwarded_proto $railway_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

limit_conn_zone $binary_remote_addr zone=migration_uploads:10m;

server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    set $api_upstream http://${API_HOST}:${API_PORT};

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain text/xml application/xml;
    gzip_min_length 256;
    gzip_vary on;
    gzip_proxied any;

    # Railway health check: answers when nginx is up, without login.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Operational metadata stays private (upstream SEC-017).
    location ~* ^/(docs|redoc|openapi\.json|metrics) {
        return 404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Migration archives can be several gigabytes: stream them to the API.
    location ~ ^/api/v1/admin/migrate/(import|validate)/?$ {
        client_max_body_size 6g;
        client_body_timeout 3600s;
        limit_conn migration_uploads 1;
        limit_conn_status 429;
        proxy_request_buffering off;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $railway_client_ip;
        proxy_set_header X-Forwarded-For $railway_client_ip;
        proxy_set_header X-Forwarded-Proto $railway_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        client_max_body_size 10m;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $railway_client_ip;
        proxy_set_header X-Forwarded-For $railway_client_ip;
        proxy_set_header X-Forwarded-Proto $railway_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /health {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
    }

    location ~ ^/\.well-known/(ard|ai-catalog)\.json$ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $railway_proto;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
